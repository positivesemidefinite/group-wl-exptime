import GroupWL.Identification
import GroupWL.PebbleGame

/-! # Complete word types are marked-subgroup isomorphism types -/

namespace GroupWL.WordAtomic

open Refinement PebbleGame

universe u v
variable {G : Type u} {H : Type v} [Group G] [Group H] {k m : ℕ}

/-- Values of group words form the subgroup generated by the tuple. -/
def wordSubgroup (a : Fin k → G) : Subgroup G where
  carrier := {g | ∃ w : GroupWord k, w.eval a = g}
  one_mem' := ⟨.one, rfl⟩
  mul_mem' := by
    rintro g h ⟨w, rfl⟩ ⟨w', rfl⟩
    exact ⟨.mul w w', rfl⟩
  inv_mem' := by
    rintro g ⟨w, rfl⟩
    exact ⟨.inv w, rfl⟩

def markedTuple (a : Fin k → G) : Fin k → wordSubgroup a :=
  fun i => ⟨a i, .gen i, rfl⟩

theorem markedTuple_generates (a : Fin k → G) : Generates (markedTuple a) := by
  intro g
  obtain ⟨w, hw⟩ := g.property
  refine ⟨w, ?_⟩
  apply Subtype.ext
  have he := GroupWord.eval_hom (wordSubgroup a).subtype (markedTuple a) w
  exact he.symm.trans hw

theorem initialII_markedTuple (a : Fin k → G) :
    initialII k (markedTuple a) = initialII k a := by
  classical
  funext w
  simp only [initialII]
  apply decide_eq_decide.mpr
  have h := GroupWord.eval_hom (wordSubgroup a).subtype (markedTuple a) w
  change w.eval a = (↑(w.eval (markedTuple a)) : G) at h
  rw [h]
  exact Subtype.ext_iff

/-- Equal initial colors construct an actual isomorphism of the two generated
subgroups, preserving every marked coordinate. -/
theorem marked_isomorphism {a : Fin k → G} {b : Fin k → H}
    (hab : initialII k a = initialII k b) :
    ∃ e : wordSubgroup a ≃* wordSubgroup b,
      ∀ i, e (markedTuple a i) = markedTuple b i := by
  have htype : initialII k (markedTuple a) = initialII k (markedTuple b) := by
    rw [initialII_markedTuple, initialII_markedTuple, hab]
  obtain ⟨f, hfinj, hfmarks⟩ :=
    embedding_of_generates_of_initialII_eq (markedTuple_generates a) htype
  have hfsurj : Function.Surjective f := by
    intro h
    obtain ⟨w, hw⟩ := markedTuple_generates b h
    refine ⟨w.eval (markedTuple a), ?_⟩
    rw [← GroupWord.eval_hom]
    have hfun : f ∘ markedTuple a = markedTuple b := funext hfmarks
    rw [hfun, hw]
  exact ⟨MulEquiv.ofBijective f ⟨hfinj, hfsurj⟩, hfmarks⟩

/-- Any position whose marks occur among matching tuple coordinates satisfies
the literal marked-subgroup atomic condition. -/
theorem atomic_of_initialII_eq {a : Fin k → G} {b : Fin k → H}
    (hab : initialII k a = initialII k b) (p : Position m G H)
    (cover : ∀ j g h, p j = some (g,h) → ∃ i, a i = g ∧ b i = h) : Atomic p := by
  obtain ⟨e, he⟩ := marked_isomorphism hab
  refine ⟨wordSubgroup a, wordSubgroup b, e, ?_⟩
  intro j g h hmark
  obtain ⟨i, rfl, rfl⟩ := cover j g h hmark
  exact ⟨(markedTuple a i).property, (markedTuple b i).property, he i⟩

end GroupWL.WordAtomic
