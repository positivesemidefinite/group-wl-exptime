import GroupWL.Refinement
import Mathlib.Data.Fintype.EquivFin

/-! # Marked word types and identification

A generating tuple's word type determines the group among groups of the
same order. All maps and their multiplicativity are constructed below.
-/
namespace GroupWL.Refinement

universe u v
variable {G : Type u} {H : Type v} [Group G] [Group H]
variable {k : ℕ}

/-- Every element is a word in the marked tuple. -/
def Generates (a : Fin k → G) : Prop := ∀ g, ∃ w : GroupWord k, w.eval a = g

theorem relations_iff_of_initialII_eq {a : Fin k → G} {b : Fin k → H}
    (h : initialII k a = initialII k b) (w : GroupWord k) :
    w.eval a = 1 ↔ w.eval b = 1 := by
  classical
  have hw := congrFun h w
  exact decide_eq_decide.mp hw

/-- Matching complete word types determines an injective homomorphism from
the group generated by the first tuple into the second ambient group. -/
theorem embedding_of_generates_of_initialII_eq {a : Fin k → G} {b : Fin k → H}
    (ha : Generates a) (h : initialII k a = initialII k b) :
    ∃ f : G →* H, Function.Injective f ∧ ∀ i, f (a i) = b i := by
  classical
  let word (g : G) : GroupWord k := Classical.choose (ha g)
  have word_spec (g : G) : (word g).eval a = g := Classical.choose_spec (ha g)
  let f (g : G) : H := (word g).eval b
  have aligned (w : GroupWord k) : f (w.eval a) = w.eval b := by
    have hw : (GroupWord.mul (word (w.eval a)) (.inv w)).eval a = 1 := by
      simp [GroupWord.eval, word_spec]
    have := (relations_iff_of_initialII_eq h _).mp hw
    simpa [GroupWord.eval, f, mul_inv_eq_one] using this
  let fm : G →* H :=
    { toFun := f
      map_one' := by simpa [GroupWord.eval] using aligned GroupWord.one
      map_mul' := fun g g' => by
        have hh := aligned (GroupWord.mul (word g) (word g'))
        simpa only [GroupWord.eval, word_spec] using hh }
  refine ⟨fm, ?_, ?_⟩
  · intro g g' hg
    have hw : (GroupWord.mul (word g) (.inv (word g'))).eval b = 1 := by
      change f g * (f g')⁻¹ = 1
      change f g = f g' at hg
      rw [hg, mul_inv_cancel]
    have := (relations_iff_of_initialII_eq h _).mpr hw
    simpa [GroupWord.eval, word_spec, mul_inv_eq_one] using this
  · intro i
    exact aligned (.gen i)

theorem isomorphic_of_generates_of_initialII_eq [Fintype G] [Fintype H]
    {a : Fin k → G} {b : Fin k → H} (ha : Generates a)
    (h : initialII k a = initialII k b) (hcard : Fintype.card G = Fintype.card H) :
    Nonempty (G ≃* H) := by
  obtain ⟨f, hf, _⟩ := embedding_of_generates_of_initialII_eq ha h
  have hsurj : Function.Surjective f := by
    by_contra hn
    have := Fintype.card_lt_of_injective_not_surjective f hf hn
    omega
  exact ⟨MulEquiv.ofBijective f ⟨hf, hsurj⟩⟩

theorem exists_matching_initialII [Fintype G] [Fintype H]
    (h : EquivalentII k G H) (a : Fin k → G) :
    ∃ b : Fin k → H, initialII k a = initialII k b := by
  have hh := h 0
  have hm : initialII k a ∈ histogram (initialII (G := G) k) 0 := by
    exact Multiset.mem_map.mpr ⟨a, Finset.mem_univ _, rfl⟩
  rw [hh] at hm
  obtain ⟨b, _, hb⟩ := Multiset.mem_map.mp hm
  exact ⟨b, hb.symm⟩

/-- This proves identification among all finite groups from an actual
k-entry generating tuple, without assuming that a mate has tensor form. -/
theorem identifiesII_of_generates [Fintype G] (hk : k ≠ 0)
    {a : Fin k → G} (ha : Generates a) : IdentifiesII k G := by
  intro H h
  obtain ⟨b, hb⟩ := exists_matching_initialII h a
  exact isomorphic_of_generates_of_initialII_eq ha hb (card_eq_of_equivalent hk h)

theorem generates_enumeration [Fintype G] :
    Generates ((Fintype.equivFin G).symm : Fin (Fintype.card G) → G) := by
  intro g
  exact ⟨.gen ((Fintype.equivFin G) g), by simp [GroupWord.eval]⟩

theorem identifiesII_at_order [Fintype G] : IdentifiesII (Fintype.card G) G :=
  identifiesII_of_generates (Fintype.card_ne_zero) generates_enumeration

end GroupWL.Refinement
